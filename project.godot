; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

"ï»¿config_version"=5
"Ã¯Â»Â¿config_version"=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="RECONgame"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=120
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://cdkcmjjgdd2j4"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
NoiseBus="*res://scripts/autoload/noise_bus.gd"
CampaignState="*res://scripts/autoload/campaign_state.gd"
GameSettings="*res://scripts/autoload/game_settings.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
AgentRegistry="*res://scripts/autoload/agent_registry.gd"
CombatManager="*res://scripts/autoload/combat_manager.gd"
TerrainEngine="*res://terrain/core/terrain_engine.gd"
DamageSystem="*res://terrain/systems/damage_system.gd"
ClearingSystem="*res://terrain/systems/clearing_system.gd"
VOManager="*res://scripts/autoload/vo_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
SimClock="*res://scripts/autoload/sim_clock.gd"
WorldSim="*res://scripts/autoload/world_sim.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/recon.log"
file_logging/max_log_files=8

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"

[editor]

movie_writer/movie_file="C:/Users/caleb/game dev captures/captures"

[filesystem]

import/blender/enabled=false

