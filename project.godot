[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"
3d_physics/layer_4="player_hitbox"
3d_physics/layer_5="enemy_hitbox"
3d_physics/layer_6="player_hurtbox"
3d_physics/layer_7="enemy_hurtbox"
3d_physics/layer_9="projectiles"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/max_bodies=32768
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/use_debanding=true
scaling_3d/mode=5
scaling_3d/scale=0.75
scaling_3d/fsr_sharpness=0.3
mesh_lod/lod_change/threshold_pixels=2.0
