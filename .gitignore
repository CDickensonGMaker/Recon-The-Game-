# Godot cache
.godot/
*.blend1

# OS
Thumbs.db
desktop.ini

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# W87: sprite-pipeline intermediates + debug captures (final sheets stay tracked)
assets/characters/source/renders/sprites/**/_frames/
screenshots/

# Python bytecode
__pycache__/
*.pyc

# Piper TTS binary + voice models (700MB, downloadable - never commit)
tools/tts/
# generated voice-over wavs (regenerated from voice_studio.py)
assets/audio/vo/

# 55MB YouTube-sourced dev ambience - license-unclear, replace for release (bead xu94)
assets/audio/ambience/jungle_day.mp3
.beads/.~*

# Derived character blends - regenerated from the tracked truth source, ~90 MB each.
# us_base_v3.blend is a pure function of us_grunt_v2.blend + tools/make_base_v3.py.
# Committing it would repeat the 165 MB blob mistake (RECONgame-t04t).
art_source/characters/base_psx/us_base_v3.blend
art_source/characters/lineup_review.blend
art_source/characters/variants/
art_source/characters/civilians/
art_source/characters/review/

# Character workspaces (Caleb 2026-07-12): one folder per family. All DERIVED -
# regenerated from the tracked truth source by tools/make_*.py. ~90 MB a piece.
art_source/characters/civilians/
art_source/characters/us_troops/
art_source/characters/enemies/
art_source/characters/locker/

# Local safety artifacts - never enter history (repo-hygiene pass 2026-07-17)
# Manual pre-edit copies and Blender recovery/auto snapshots. Regeneratable or
# throwaway; the two already-tracked backup blobs get git-rm --cached in the same pass.
_backups/
*_BEFORE_*.blend
*_BROKEN_STATE.blend
*_PREANIM_backup.blend
*_RECOVERED_*.blend
# Transient run logs at repo root only - war_room/**/*.log evidence stays tracked (ADR-015)
/*.log
# Work-in-progress temp test scaffolds
tests/*_TMP.*

# Bench artifacts - screenshots + CSV rows, heavy and regenerable (2026-07-17)
production/war_room/**/bench_*/
# Godot CSV-as-translation import sidecars from headless bench runs (regenerable)
production/war_room/**/*.translation
production/war_room/**/*.csv.import
# Stale throwaway preview renders
*_STALE_*

# Cinematics render outputs - regenerable + heavy (frame dumps ~95MB, video encodes,
# ~300MB per cutscene). Sources (.blend, stills) stay tracked; the renders never enter history.
production/cinematics/**/frames/
production/cinematics/**/*.mp4
production/cinematics/**/*.ogv
production/cinematics/**/*.mkv
production/cinematics/**/*.webm

# ---------------------------------------------------------------------------
# Oversized-blob firewall (RECONgame-yu8b, 2026-07-19)
# These six paths exceeded GitHub's hard 100 MB per-file limit and blocked the
# push for 97 commits. They were purged from unpushed history with git-filter-repo.
# The files REMAIN ON DISK on purpose - they are live art source, not garbage.
# The earlier rules missed them because they only covered the old art_source/
# locations; these are the paths the files actually live at today.
assets/us/characters/us_base_v3.blend
assets/reference/review/lineup_review.blend
production/cinematics/cutscene_01_operation_briefing/cutscene_01_staging.blend
production/cinematics/cutscene_02_huey_insertion/cutscene_02_huey_insertion.blend

# Cinematics are a standalone Blender FMV production and do not belong on GitHub
# at all (owner decree 2026-07-19). Source blends only - rendered output and
# authored docs in this tree stay tracked.
production/cinematics/**/*.blend

# Catch every location variant of the two armory backups. They have already moved
# once (art_source/_backups/ -> _backups/), which defeated a path-anchored rule
# and is exactly how they re-entered history.
**/gear_armory_BROKEN_STATE.blend
**/gear_armory_BEFORE_civsplit.blend
**/us_base_v3.blend
**/lineup_review.blend
